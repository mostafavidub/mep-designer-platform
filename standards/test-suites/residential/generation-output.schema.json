{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "architecture-generation-output/1.0"
    },
    "status": {
      "enum": [
        "VALIDATED",
        "REVIEW_REQUIRED",
        "INPUT_REQUIRED",
        "CONFLICT",
        "NO_FEASIBLE_LAYOUT"
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rulebook_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_identity": {
      "type": "object",
      "minProperties": 1
    },
    "construction_authorized": {
      "const": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "geometry_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hard_gate": {
            "enum": [
              "PASS",
              "FAIL",
              "INPUT_REQUIRED",
              "REVIEW_REQUIRED"
            ]
          },
          "soft_scores": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "review_required": {
            "const": true
          }
        },
        "required": [
          "candidate_id",
          "geometry_hash",
          "hard_gate",
          "soft_scores",
          "review_required"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_input": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reason",
          "source_refs",
          "required_input"
        ],
        "additionalProperties": false
      }
    },
    "infeasibility_proof": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "proof_kind": {
              "enum": [
                "EXHAUSTIVE_FINITE",
                "CERTIFIED_SOLVER"
              ]
            },
            "binding_constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "proof_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "proof_kind",
            "binding_constraints",
            "proof_hash"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "status",
    "input_hash",
    "rulebook_hash",
    "build_identity",
    "construction_authorized",
    "candidates",
    "blockers",
    "infeasibility_proof"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NO_FEASIBLE_LAYOUT"
          }
        }
      },
      "then": {
        "properties": {
          "infeasibility_proof": {
            "type": "object"
          },
          "candidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "VALIDATED"
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          },
          "candidates": {
            "minItems": 1,
            "items": {
              "properties": {
                "hard_gate": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    }
  ]
}
