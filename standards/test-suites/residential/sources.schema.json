{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "architecture-sources/1.1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "access_date": {
            "type": "string"
          },
          "copyright_note": {
            "type": "string"
          },
          "cover_verified": {
            "type": "boolean"
          },
          "current_status_basis": {
            "type": "string"
          },
          "edition_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "issuer": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "local_filename": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "publication_date": {
            "type": "null"
          },
          "scope": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "evidence_grade": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "qualification_status": {
            "enum": [
              "QUALIFIED_REFERENCE",
              "SOURCE_GAP"
            ]
          },
          "permitted_use": {
            "type": "string"
          },
          "may_solo_support_release_block": {
            "type": "boolean"
          },
          "document_status": {
            "type": "string"
          },
          "source_class": {
            "type": "string"
          },
          "official_url_or_identifier": {
            "type": "string"
          },
          "amendment_chain": {
            "type": "array"
          },
          "verification_status": {
            "type": "string"
          }
        },
        "required": [
          "issuer",
          "notes",
          "source_id",
          "status",
          "title",
          "evidence_grade",
          "qualification_status",
          "permitted_use",
          "may_solo_support_release_block"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "source_id": {
                  "enum": [
                    "IR-M3",
                    "IR-M4",
                    "IR-ACCESS"
                  ]
                }
              },
              "required": [
                "source_id"
              ]
            },
            "then": {
              "required": [
                "document_status",
                "source_class",
                "official_url_or_identifier",
                "amendment_chain",
                "verification_status"
              ]
            }
          }
        ]
      }
    },
    "authority_assessments": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "sources",
    "authority_assessments"
  ],
  "additionalProperties": false
}
