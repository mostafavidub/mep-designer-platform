{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "status",
    "authority_boundary",
    "source_inventory",
    "rule_audit",
    "gap_resolution",
    "local_authority_contract",
    "discipline_coverage",
    "ergonomics",
    "owner_program",
    "golden_program",
    "readiness"
  ],
  "properties": {
    "schema_version": {
      "const": "architecture-research-completion/1.0"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "const": "ARCHITECTURE_RULEBOOK_BLOCKED"
    },
    "authority_boundary": {
      "type": "object"
    },
    "source_inventory": {
      "type": "object"
    },
    "rule_audit": {
      "type": "object"
    },
    "gap_resolution": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "gap",
          "result",
          "authority"
        ],
        "properties": {
          "gap": {
            "type": "string"
          },
          "result": {
            "enum": [
              "RESOLVED_NATIONAL_RULE",
              "RESOLVED_LOCAL_RULE_MODEL",
              "RESOLVED_HEURISTIC",
              "OWNER_INPUT_REQUIRED",
              "PROJECT_INPUT_REQUIRED",
              "SOURCE_MISSING",
              "HUMAN_EXPERT_REVIEW_REQUIRED"
            ]
          },
          "authority": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "local_authority_contract": {
      "type": "object"
    },
    "discipline_coverage": {
      "type": "object"
    },
    "ergonomics": {
      "type": "object"
    },
    "owner_program": {
      "type": "object"
    },
    "golden_program": {
      "type": "object"
    },
    "readiness": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
