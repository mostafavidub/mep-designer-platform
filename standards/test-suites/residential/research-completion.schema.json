{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "status",
    "authority_boundary",
    "source_inventory",
    "rule_audit",
    "gap_resolution",
    "local_authority_contract",
    "discipline_coverage",
    "ergonomics",
    "owner_program",
    "golden_program",
    "readiness",
    "primary_authority_closure"
  ],
  "properties": {
    "schema_version": {
      "const": "architecture-research-completion/1.0"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ARCHITECTURE_RULEBOOK_BLOCKED",
        "PRIMARY_AUTHORITY_CLOSURE_BLOCKED",
        "ARCH_RULE_ACTIVATION_PARTIAL"
      ]
    },
    "authority_boundary": {
      "type": "object"
    },
    "source_inventory": {
      "type": "object"
    },
    "rule_audit": {
      "type": "object"
    },
    "gap_resolution": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "gap",
          "result",
          "authority"
        ],
        "properties": {
          "gap": {
            "type": "string"
          },
          "result": {
            "enum": [
              "RESOLVED_NATIONAL_RULE",
              "RESOLVED_LOCAL_RULE_MODEL",
              "RESOLVED_HEURISTIC",
              "OWNER_INPUT_REQUIRED",
              "PROJECT_INPUT_REQUIRED",
              "SOURCE_MISSING",
              "HUMAN_EXPERT_REVIEW_REQUIRED"
            ]
          },
          "authority": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "local_authority_contract": {
      "type": "object"
    },
    "discipline_coverage": {
      "type": "object"
    },
    "ergonomics": {
      "type": "object"
    },
    "owner_program": {
      "type": "object"
    },
    "golden_program": {
      "type": "object"
    },
    "readiness": {
      "type": "object"
    },
    "primary_authority_closure": {
      "type": "object",
      "required": [
        "retrieved_date",
        "final_status",
        "m4",
        "m3",
        "accessibility",
        "release_ready_rules",
        "human_architect_review_required_rules",
        "generator_gate"
      ],
      "additionalProperties": false,
      "properties": {
        "retrieved_date": {
          "type": "string"
        },
        "final_status": {
          "type": "string"
        },
        "m4": {
          "type": "string"
        },
        "m3": {
          "type": "string"
        },
        "accessibility": {
          "type": "string"
        },
        "release_ready_rules": {
          "type": "integer"
        },
        "human_architect_review_required_rules": {
          "type": "integer"
        },
        "generator_gate": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
