    },
    "status": {
      "type": "string"
    },
    "reviewer_decisions": {
      "type": "array",
      "maxItems": 0
    },
    "items": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "review_item_id": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "clause": {
            "type": "string"
          },
          "page": {
            "type": "object"
          },
          "applicability": {
            "type": "string"
          },
          "exceptions": {
            "type": "array"
          },
          "machine_logic": {},
          "pass_example": {
            "type": "string"
          },
          "fail_example": {
            "type": "string"
          },
          "open_question": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "rule_summary_fa": {
            "type": "string"
          },
          "boundary_example": {
            "type": "string"
          },
          "recommended_decision": {
            "type": "string"
          },
          "human_review_status": {
            "type": "string"
          },
          "open_issue": {
            "type": "string"
          },
          "cross_code_interaction": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "review_item_id",
          "rule_id",
          "source",
          "edition",
          "clause",
          "page",
          "applicability",
          "exceptions",
          "machine_logic",
          "pass_example",
          "fail_example",
          "open_question",
          "status",
          "rule_summary_fa",
          "boundary_example",
          "recommended_decision",
          "human_review_status",
          "open_issue",
          "cross_code_interaction"
        ],
        "additionalProperties": false
      }
    }
  }
}
