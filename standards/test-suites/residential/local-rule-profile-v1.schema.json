{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-local-rule-profile/1.0",
  "title": "Planha LocalRuleProfile 1.0",
  "type": "object",
  "required": ["schema_version", "profile_id", "profile_revision", "country", "province", "city", "municipality", "municipal_district", "planning_zone", "effective_from", "effective_until", "source_documents", "rules", "verification_status", "review", "profile_hash", "runtime_enabled"],
  "properties": {
    "schema_version": {"const": "architecture-local-rule-profile/1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_revision": {"type": "integer", "minimum": 1},
    "country": {"const": "IR"},
    "province": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "municipality": {"type": "string", "minLength": 1},
    "municipal_district": {"type": ["string", "null"], "minLength": 1},
    "planning_zone": {"type": ["string", "null"], "minLength": 1},
    "effective_from": {"type": "string", "format": "date"},
    "effective_until": {"type": ["string", "null"], "format": "date"},
    "source_documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "verification_status": {"enum": ["UNVERIFIED", "AUTHORITY_REVIEW_REQUIRED", "AUTHORITY_QUALIFIED", "STALE"]},
    "review": {"type": ["object", "null"]},
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_enabled": {"const": false},
    "markers": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["NON_GOLDEN", "NON_REGULATORY_TEST_DATA", "NOT_PROFESSIONALLY_APPROVED"]}}
  },
  "$defs": {
    "review": {
      "type": "object",
      "required": ["reviewer_id", "reviewer_role", "qualification_reference", "review_date", "source_reference", "source_revision", "project_scope", "decision", "decision_evidence"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1}, "reviewer_role": {"type": "string", "minLength": 1},
        "qualification_reference": {"type": "string", "minLength": 1}, "review_date": {"type": "string", "format": "date"},
        "source_reference": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1},
        "project_scope": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1},
        "decision_evidence": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_id", "document_title", "official_directive_id", "issuing_authority", "document_revision", "publication_date", "effective_date", "supersedes", "superseded_by", "official_reference", "retrieval_date", "content_hash", "verification_status", "review"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1}, "document_title": {"type": "string", "minLength": 1},
        "official_directive_id": {"type": "string", "minLength": 1}, "issuing_authority": {"type": "string", "minLength": 1},
        "document_revision": {"type": "string", "minLength": 1}, "publication_date": {"type": "string", "format": "date"},
        "effective_date": {"type": "string", "format": "date"}, "supersedes": {"type": "array", "items": {"type": "string"}},
        "superseded_by": {"type": ["string", "null"]}, "official_reference": {"type": "string", "minLength": 1},
        "retrieval_date": {"type": "string", "format": "date"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification_status": {"enum": ["UNVERIFIED", "AUTHORITY_REVIEW_REQUIRED", "AUTHORITY_QUALIFIED", "STALE"]},
        "review": {"anyOf": [{"$ref": "#/$defs/review"}, {"type": "null"}]}
      }, "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "authority_type", "topic", "jurisdiction_scope", "temporal_scope", "applicability_expression", "required_inputs", "operator_or_formula", "unit", "exceptions", "source_id", "clause_reference", "page_reference", "verification_status", "review"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1}, "authority_type": {"const": "LOCAL_CODE"},
        "topic": {"enum": ["SETBACK", "BUILDING_LINE", "SITE_COVERAGE", "FAR_DENSITY", "MAX_HEIGHT", "PARKING", "VEHICLE_ACCESS", "PEDESTRIAN_ACCESS", "SPECIAL_DISTRICT", "PARCEL_EXCEPTION", "ELEVATOR", "LOCAL_FIRE", "ACCESSIBILITY"]},
        "jurisdiction_scope": {"type": "object"}, "temporal_scope": {"type": "object"},
        "applicability_expression": {"type": "object"}, "required_inputs": {"type": "array", "items": {"type": "string"}},
        "operator_or_formula": {"type": "object"}, "unit": {"type": ["string", "null"]},
        "exceptions": {"type": "array", "items": {"type": "object"}}, "source_id": {"type": "string", "minLength": 1},
        "clause_reference": {"type": "string", "minLength": 1}, "page_reference": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["UNVERIFIED", "AUTHORITY_REVIEW_REQUIRED", "AUTHORITY_QUALIFIED", "STALE"]},
        "review": {"anyOf": [{"$ref": "#/$defs/review"}, {"type": "null"}]}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
