{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planha-package-manifest/1.0",
  "type": "object",
  "required": ["schema", "package_status", "source_embedding", "source_sha256", "canonical_schema", "snapshot_schema", "snapshot_id", "files"],
  "properties": {"schema": {"const": "planha-package-manifest/1.0"}, "package_status": {"const": "EXPERIMENTAL_INTERNAL"}, "source_embedding": {"const": "REFERENCE_BY_SHA256_ONLY"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "files": {"type": "object", "required": ["architecture.json", "review.json", "snapshot.json", "validation.json"]}}
}
