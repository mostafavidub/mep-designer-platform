{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planha-architecture-review/1.0",
  "type": "object",
  "required": ["schema", "review_item_id", "source_sha256", "frame_or_level_id", "object_or_region_id", "geometry_fingerprint", "evidence_fingerprint", "candidate_interpretations", "allowed_answers", "impact", "review_scope", "review_authority", "review_fingerprint", "manual_geometry_authority"],
  "properties": {"schema": {"const": "planha-architecture-review/1.0"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "candidate_interpretations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "allowed_answers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "minItems": 1}, "question_type": {"enum": ["SPACE_CLASSIFICATION", "OPEN_PLAN_CONFIRMATION", "PORTAL_INTERPRETATION", "VOID_INTERPRETATION", "WALL_CONTINUITY_INTERPRETATION", "FRAME_LEVEL_CLASSIFICATION", "SOURCE_ROLE_CLASSIFICATION", "OTHER_BOUNDED_SOURCE_INTERPRETATION"]}, "evidence_summary": {"type": "object"}, "impact_classification": {"enum": ["RELEASE_CRITICAL", "DOWNSTREAM_CRITICAL", "REVIEW_CRITICAL", "NONCRITICAL_DIAGNOSTIC"]}, "validator_issue_ids_covered": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "expected_effects": {"type": "object"}, "can_resolve_without_geometry_creation": {"type": "boolean"}, "blocking_status": {"enum": ["BLOCKING", "NONBLOCKING"]}, "preview_spec": {"type": "object"}, "identity_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ai_recommendation_authority": {"const": "ADVISORY_ONLY"}, "review_authority": {"const": "HUMAN_SOURCE_INTERPRETATION"}, "manual_geometry_authority": {"const": false}}
}
