{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planha://rulebook/executable-rule/1.0",
  "title": "Planha executable engineering rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "version", "owner", "subsystem", "kind", "authority", "sources", "applicability", "required_inputs", "design_actions", "validator", "output_evidence"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"enum": ["architecture", "structural", "mechanical", "electrical", "fire", "shared"]},
    "subsystem": {"type": "string", "minLength": 1},
    "kind": {"enum": ["OPERATIVE", "CONDITIONAL", "DEFINITION", "GUIDANCE", "DEPENDENCY", "UNRESOLVED_CONTROL", "DOCUMENTED_NOT_APPLICABLE"]},
    "authority": {"enum": ["STATUTORY_MANDATORY", "STATUTORY_GUIDANCE", "INTERNAL_ENGINEERING", "PROJECT_INPUT", "UNRESOLVED"]},
    "title_fa": {"type": "string"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "applicability": {"$ref": "#/$defs/applicability"},
    "exceptions": {"type": "array", "items": {"type": "object"}},
    "cross_references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "design_actions": {"type": "array", "items": {"type": "string"}},
    "validator": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "output_evidence": {"type": "array", "items": {"type": "string"}},
    "unknown_policy": {"const": "INPUT_REQUIRED"},
    "llm_override_allowed": {"const": false}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "edition", "clause", "printed_page", "source_ids"],
      "properties": {
        "code": {"enum": ["M4", "M6", "M16", "PLANHA_INTERNAL"]},
        "edition": {"type": "string"}, "clause": {"type": "string"},
        "printed_page": {"type": ["integer", "string"]},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "status": {"enum": ["VERIFIED_SOURCE", "PRINT_ANOMALY_PRESERVED", "INTERNAL_GOVERNED"]}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["predicate", "unknown_result"],
      "properties": {"predicate": {"type": "string"}, "unknown_result": {"const": "INPUT_REQUIRED"}}
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "unit", "authority"],
      "properties": {
        "field": {"type": "string"}, "unit": {"type": ["string", "null"]},
        "authority": {"type": "array", "minItems": 1, "items": {"enum": ["SOURCE_VERIFIED", "USER_CONFIRMED", "OFFICIAL_DATA", "ENGINEER_APPROVED", "STRUCTURAL_APPROVAL", "PRODUCT_APPROVAL", "PHYSICAL_TEST"]}}
      }
    }
  }
}
