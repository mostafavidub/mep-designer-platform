    "rules": [
        {
            "rule_id": "IR-M16-1396-16.4.2.3-TRAP-MIN-DN",
            "version": "1.0.0",
            "owner": "mechanical",
            "subsystem": "sanitary",
            "kind": "OPERATIVE",
            "authority": "STATUTORY_MANDATORY",
            "title_fa": "\u062d\u062f\u0627\u0642\u0644 \u0642\u0637\u0631 \u0646\u0627\u0645\u06cc \u0633\u06cc\u0641\u0648\u0646 \u0644\u0648\u0627\u0632\u0645 \u0628\u0647\u062f\u0627\u0634\u062a\u06cc",
            "sources": [
                {
                    "code": "M16",
                    "edition": "1396",
                    "clause": "16-4-2-3(t-1), table",
                    "printed_page": 86,
                    "source_ids": [
                        "M16-SV-001"
                    ],
                    "status": "VERIFIED_SOURCE"
                }
            ],
            "applicability": {
                "predicate": "trapped_sanitary_fixture_exists",
                "unknown_result": "INPUT_REQUIRED"
            },
            "exceptions": [],
            "cross_references": [],
            "required_inputs": [
                {
                    "field": "sanitary.traps[].fixture_type",
                    "unit": null,
                    "authority": [
                        "SOURCE_VERIFIED"
                    ]
                },
                {
                    "field": "sanitary.traps[].dn_mm",
                    "unit": "mm",
                    "authority": [
                        "GEOMETRY_VERIFIED"
                    ]
                }
            ],
            "design_actions": [
                "select each fixture trap at or above the exact printed nominal diameter"
            ],
            "validator": "trap_minimum_dn",
            "parameters": {
                "minimum_dn_mm": {
                    "basin": 32,
                    "bidet": 32,
                    "public_sink": 40,
                    "bath": 40,
                    "shower_tray": 40,
                    "drinking_fountain": 32,
                    "kitchen_or_restaurant_sink": 40,
                    "urinal": 40,
                    "eastern_toilet": 100,
                    "hand_laundry_tray": 40,
                    "domestic_washing_machine": 50,
                    "commercial_washing_machine": 80,
                    "domestic_dishwasher": 40,
                    "commercial_dishwasher": 80,
                    "domestic_floor_drain": 50,
                    "public_commercial_floor_drain": 80
                }
            },
            "output_evidence": [
                "trap schedule",
                "fixture waste connection DN"
            ],
            "unknown_policy": "INPUT_REQUIRED",
            "llm_override_allowed": false
        },
        {
            "rule_id": "IR-M16-1396-16.4.2.4-HORIZONTAL-SLOPE",
            "version": "1.0.0",
            "owner": "mechanical",
            "subsystem": "sanitary",
            "kind": "OPERATIVE",
            "authority": "STATUTORY_MANDATORY",
            "title_fa": "\u0634\u06cc\u0628 \u0648 \u0633\u0631\u0639\u062a \u0634\u0627\u062e\u0647\u200c\u0647\u0627\u06cc \u0627\u0641\u0642\u06cc \u0641\u0627\u0636\u0644\u0627\u0628",
            "sources": [
                {
                    "code": "M16",
                    "edition": "1396",
                    "clause": "16-4-2-4(a,b), table 16-4-2-4(b-2)",
                    "printed_page": 87,
                    "source_ids": [
                        "M16-SV-002"
                    ],
                    "status": "VERIFIED_SOURCE"
                }
            ],
            "applicability": {
                "predicate": "horizontal_sanitary_segment_exists",
                "unknown_result": "INPUT_REQUIRED"
            },
            "exceptions": [],
            "cross_references": [],
            "required_inputs": [
                {
                    "field": "sanitary.horizontal_segments[].dn_mm",
                    "unit": "mm",
                    "authority": [
                        "GEOMETRY_VERIFIED"
                    ]
                },
                {
                    "field": "sanitary.horizontal_segments[].slope_percent",
                    "unit": "percent",
                    "authority": [
                        "GEOMETRY_VERIFIED"
                    ]
                },
                {
                    "field": "sanitary.horizontal_segments[].velocity_m_s",
                    "unit": "m/s",
                    "authority": [
                        "HYDRAULIC_CALCULATION"
                    ]
                }
            ],
            "design_actions": [
                "maintain uniform downstream slope, at least the exact DN-band minimum and no more than 4 percent, with calculated velocity at least 0.7 m/s"
            ],
            "validator": "horizontal_slope_velocity",
            "parameters": {
                "minimum_velocity_m_s": 0.7,
                "maximum_slope_percent": 4.0,
                "minimum_slope_percent": {
                    "dn_le_65": 2.0,
                    "dn_80_to_150": 1.0,
                    "dn_ge_200": 0.5
                }
            },
            "output_evidence": [
                "segment slope and velocity schedule",
                "slope arrows and pipe DN"
            ],
            "unknown_policy": "INPUT_REQUIRED",
            "llm_override_allowed": false
        },
        {
            "rule_id": "IR-M16-1396-16.5.2.4-VENT-TERMINATION",
            "version": "1.0.0",
            "owner": "mechanical",
            "subsystem": "sanitary_vent",
            "kind": "OPERATIVE",
            "authority": "STATUTORY_MANDATORY",
            "title_fa": "\u0641\u0627\u0635\u0644\u0647 \u0627\u0646\u062a\u0647\u0627\u06cc \u0647\u0648\u0627\u06a9\u0634 \u0627\u0632 \u0628\u0627\u0632\u0634\u0648 \u0648 \u0645\u062d\u062f\u0648\u062f\u0647 \u0645\u0644\u06a9",
            "sources": [
                {
                    "code": "M16",
                    "edition": "1396",
                    "clause": "16-5-2-4(b)",
                    "printed_page": 110,
                    "source_ids": [
                        "M16-SV-003"
                    ],
                    "status": "VERIFIED_SOURCE"
                }
            ],
            "applicability": {
                "predicate": "sanitary_vent_termination_exists",
                "unknown_result": "INPUT_REQUIRED"
            },
            "exceptions": [
                {
                    "when": "horizontal_to_opening_m < 3 AND vertical_above_opening_m >= 1",
                    "result": "PASS",
                    "reason": "printed vertical-offset alternative"
                }
            ],
            "cross_references": [],
            "required_inputs": [
                {
                    "field": "vent.terminations[]",
                    "unit": "m",
                    "authority": [
                        "GEOMETRY_VERIFIED"
                    ]
                }
            ],
            "design_actions": [
                "do not terminate directly below an opening; keep 3 m horizontal clearance or terminate at least 1 m above it; wall outlets also require 3 m property and ground clearance and must not be below a balcony or canopy"
            ],
            "validator": "vent_termination_clearance",
            "parameters": {
                "opening_horizontal_m": 3.0,
                "opening_vertical_above_m": 1.0,
                "wall_property_horizontal_m": 3.0,
                "wall_height_above_ground_m": 3.0
            },
            "output_evidence": [
                "vent termination clearance schedule",
                "termination and opening geometry"
            ],
            "unknown_policy": "INPUT_REQUIRED",
            "llm_override_allowed": false
        },
        {
            "rule_id": "IR-M16-1396-16.5.2.5-TRAP-VENT-DISTANCE",
            "version": "1.0.0",
            "owner": "mechanical",
            "subsystem": "sanitary_vent",
            "kind": "CONDITIONAL",
            "authority": "STATUTORY_MANDATORY",
            "title_fa": "\u062d\u062f\u0627\u06a9\u062b\u0631 \u0641\u0627\u0635\u0644\u0647 \u0627\u062a\u0635\u0627\u0644 \u0647\u0648\u0627\u06a9\u0634 \u062a\u0627 \u0633\u0631\u0631\u06cc\u0632 \u0633\u06cc\u0641\u0648\u0646",
            "sources": [
                {
                    "code": "M16",
                    "edition": "1396",
                    "clause": "16-5-2-5(t-1), table",
                    "printed_page": 112,
                    "source_ids": [
                        "M16-SV-004"
                    ],
                    "status": "VERIFIED_SOURCE"
                }
            ],
            "applicability": {
                "predicate": "dry_fixture_vent_connection_exists",
                "unknown_result": "INPUT_REQUIRED"
            },
            "exceptions": [],
            "cross_references": [],
            "required_inputs": [
                {
                    "field": "vent.fixture_connections[].waste_dn_mm",
                    "unit": "mm",
                    "authority": [
                        "GEOMETRY_VERIFIED"
                    ]
                },
                {
                    "field": "vent.fixture_connections[].waste_slope_percent",
                    "unit": "percent",
                    "authority": [
                        "GEOMETRY_VERIFIED"
                    ]
                },
                {
                    "field": "vent.fixture_connections[].trap_weir_to_vent_m",
                    "unit": "m",
                    "authority": [
                        "GEOMETRY_VERIFIED"
                    ]
                }
            ],
            "design_actions": [
                "limit trap-weir-to-vent distance to the exact printed DN and 2-percent-slope row"
            ],
            "validator": "trap_vent_distance",
            "parameters": {
                "rows": {
                    "50@2": {
                        "maximum_m": 1.8
                    },
                    "80@2": {
                        "maximum_m": 3.0
                    },
                    "100@2": {
                        "maximum_m": 4.0
                    }
                }
            },
            "output_evidence": [
                "trap-to-vent distance schedule",
                "source-bound connection geometry"
            ],
            "unknown_policy": "INPUT_REQUIRED",
            "llm_override_allowed": false
        },
        {
            "rule_id":"IR-M16-1396-APP3-FIXTURE-DFU","version":"1.0.0","owner":"mechanical","subsystem":"sanitary","kind":"OPERATIVE","authority":"STATUTORY_MANDATORY","title_fa":"واحد تخلیه فاضلاب وسایل بهداشتی",
