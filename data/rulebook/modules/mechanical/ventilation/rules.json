{"rule_id":"IR-M14-1391-T14.4.2-PARKING-VENTILATION-RATES","version":"1.0.0","owner":"mechanical","subsystem":"parking_ventilation","kind":"OPERATIVE","authority":"STATUTORY_MANDATORY","title_fa":"حداقل هوای پارکینگ خصوصی و مشترک","sources":[{"code":"M14","edition":"1391","clause":"Table 14-4-2","printed_page":42,"source_ids":["M14-V-003"],"status":"VERIFIED_SOURCE"}],"applicability":{"predicate":"complete_space_inventory_contains_private_or_common_parking","unknown_result":"INPUT_REQUIRED"},"exceptions":[],"cross_references":["IR-M14-1391-14.4.4.6-ENCLOSED-PARKING-CO-CONTROL"],"required_inputs":[{"field":"ventilation.spaces[].usage","unit":null,"authority":["SOURCE_VERIFIED"]},{"field":"ventilation.spaces[].vehicle_count","unit":"vehicle","authority":["GEOMETRY_VERIFIED"]},{"field":"ventilation.spaces[].floor_area_m2","unit":"m2","authority":["GEOMETRY_VERIFIED"]},{"field":"ventilation.spaces[].design_ventilation_lps","unit":"L/s","authority":["ENGINEER_APPROVED"]}],"design_actions":["provide at least 50 L/s per automobile for private parking and 7.5 L/s per m2 of floor area for common parking; preserve each table row's distinct basis"],"validator":"ventilation_parking_rates","parameters":{"private_parking_lps_per_vehicle":50.0,"common_parking_lps_per_m2":7.5,"litres_per_second_to_m3_per_hour":3.6},"output_evidence":["complete typed parking inventory","verified vehicle count or floor polygon area","per-space statutory airflow calculation","selected ventilation duty schedule"],"unknown_policy":"INPUT_REQUIRED","llm_override_allowed":false},
{"rule_id":"IR-M14-1391-14.4.4.6-ENCLOSED-PARKING-CO-CONTROL","version":"1.0.0","owner":"mechanical","subsystem":"parking_ventilation","kind":"CONDITIONAL","authority":"STATUTORY_MANDATORY","title_fa":"ظرفیت و کنترل مونوکسیدکربن پارکینگ و گاراژ بسته","sources":[{"code":"M14","edition":"1391","clause":"14-4-4-6","printed_page":41,"source_ids":["M14-V-004"],"status":"VERIFIED_SOURCE"}],"applicability":{"predicate":"parking_or_garage_is_enclosed","unknown_result":"INPUT_REQUIRED"},"exceptions":[],"cross_references":["IR-M14-1391-T14.4.2-PARKING-VENTILATION-RATES"],"required_inputs":[{"field":"ventilation.spaces[].enclosure","unit":null,"authority":["GEOMETRY_VERIFIED"]},{"field":"ventilation.spaces[].floor_area_m2","unit":"m2","authority":["GEOMETRY_VERIFIED"]},{"field":"ventilation.spaces[].full_system_capacity_lps","unit":"L/s","authority":["ENGINEER_APPROVED"]},{"field":"ventilation.spaces[].co_control_setpoint_ppm","unit":"ppm","authority":["ENGINEER_APPROVED"]},{"field":"ventilation.spaces[].minimum_controlled_capacity_lps","unit":"L/s","authority":["ENGINEER_APPROVED"]},{"field":"ventilation.spaces[].automatic_operation_enabled","unit":null,"authority":["ENGINEER_APPROVED"]},{"field":"ventilation.spaces[].pollutant_control_enabled","unit":null,"authority":["ENGINEER_APPROVED"]}],"design_actions":["automatically operate enclosed parking or garage ventilation while vehicles are operating or people are present so carbon-monoxide concentration remains below 25 ppm","provide full-system capacity of at least 7.5 L/s per m2 of floor area","when automatic pollutant control reduces airflow, do not reduce controlled capacity below 0.25 L/s per m2"],"validator":"ventilation_enclosed_parking_co_control","parameters":{"maximum_co_ppm_exclusive":25.0,"full_capacity_lps_per_m2":7.5,"minimum_controlled_capacity_lps_per_m2":0.25},"output_evidence":["verified enclosed parking polygon and area","full and minimum controlled airflow calculations","CO sensor/control sequence and setpo