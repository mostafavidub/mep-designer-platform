            "sources": [
                {
                    "code": "M16",
                    "edition": "1396",
                    "clause": "16-3-3-5(a,b), table 16-3-3-5(b)",
                    "printed_page": 44,
                    "source_ids": [
                        "M16-WATER-008"
                    ],
                    "status": "VERIFIED_SOURCE"
                }
            ],
            "applicability": {
                "predicate": "water_fixture_outlet_exists",
                "unknown_result": "INPUT_REQUIRED"
            },
            "exceptions": [],
            "cross_references": [],
            "required_inputs": [
                {
                    "field": "water.fixture_outlets[].fixture_type",
