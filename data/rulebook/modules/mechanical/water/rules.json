        {
            "rule_id": "IR-M16-1396-16.3.3.1-HOT-COLD-BACKFLOW",
            "version": "1.0.0",
            "owner": "mechanical",
            "subsystem": "domestic_water",
            "kind": "OPERATIVE",
            "authority": "STATUTORY_MANDATORY",
            "title_fa": "\u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062c\u0631\u06cc\u0627\u0646 \u0622\u0628 \u06af\u0631\u0645 \u0628\u0647 \u0634\u0628\u06a9\u0647 \u0622\u0628 \u0633\u0631\u062f",
