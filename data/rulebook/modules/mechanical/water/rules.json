                {
                    "code": "M16",
                    "edition": "1396",
                    "clause": "16-3-3-1(b)",
                    "printed_page": 41,
                    "source_ids": [
                        "M16-WATER-001"
                    ],
                    "status": "VERIFIED_SOURCE"
                }
            ],
            "applicability": {
                "predicate": "hot_and_cold_water_interconnection_exists",
                "unknown_result": "INPUT_REQUIRED"
            },
            "exceptions": [],
            "cross_references": [],
            "required_inputs": [
                {
                    "field": "water.interconnections[].backflow_prevention",
                    "unit": null,
                    "authority": [
                        "GEOMETRY_VERIFIED"
                    ]
                },
                {
                    "field": "water.interconnections[].device_id",
                    "unit": null,
                    "authority": [
                        "PRODUCT_DATA"
                    ]
                }
            ],
            "design_actions": [
                "provide a source-bound backflow-prevention device at each hot/cold interconnection"
            ],
            "validator": "hot_cold_backflow_prevention",
            "parameters": {},
            "output_evidence": [
                "backflow device schedule",
                "device tag on water plan"
            ],
            "unknown_policy": "INPUT_REQUIRED",
            "llm_override_allowed": false
        },
