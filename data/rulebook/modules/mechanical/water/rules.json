                "minimum_flowing_pressure_mwc": {
                    "bath": 5.5,
                    "thermostatic_bath": 14,
                    "bidet": 2.7,
                    "thermostatic_bidet": 14,
                    "mixing_valve": 5.5,
                    "domestic_dishwasher": 5.5,
                    "drinking_fountain": 5.5,
                    "laundry_tray": 5.5,
                    "basin": 5.5,
                    "shower": 5.5,
                    "thermostatic_shower": 14,
                    "hose_bib": 5.5,
                    "ablution_faucet": 5.5,
                    "sink": 5.5,
                    "domestic_kitchen_sink": 5.5,
                    "public_wash_sink": 5.5,
                    "urinal_flush_valve": 17,
                    "toilet_flush_valve": 17,
                    "toilet_flush_tank": 5.5
                }
            },
            "output_evidence": [
                "critical outlet pressure schedule",
                "pressure-zone or reducer annotation"
            ],
            "unknown_policy": "INPUT_REQUIRED",
            "llm_override_allowed": false
        },
        {
