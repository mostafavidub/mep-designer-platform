                    "electronic_faucet_basin": {
                        "value": 6,
                        "unit": "L/min"
                    },
                    "shower": {
                        "value": 8,
                        "unit": "L/min"
                    },
                    "sink": {
                        "value": 8,
                        "unit": "L/min"
                    },
                    "urinal": {
                        "value": 2,
                        "unit": "L/flush"
                    },
                    "dual_flush_toilet": {
                        "value": 6,
                        "unit": "L/flush",
                        "secondary_value": 3
                    },
                    "ablution_faucet": {
                        "value": 6,
                        "unit": "L/min"
                    }
                }
