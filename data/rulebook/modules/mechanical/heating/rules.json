policy":"INPUT_REQUIRED","llm_override_allowed":false},
    {"rule_id":"IR-M14-1391-14.7.8.2-OPEN-TANK-ELEVATION","version":"1.0.0","owner":"mechanical","subsystem":"hot_water_heating_expansion","kind":"CONDITIONAL","authority":"STATUTORY_MANDATORY","title_fa":"حداقل تراز سطح آب مخزن انبساط باز","sources":[{"code":"M14","edition":"1391","clause":"14-7-8-2(a)","printed_page":81,"source_ids":["M14-H-004"],"status":"VERIFIED_SOURCE"}],"applicability":{"predicate":"hot_water_heating_system_uses_open_expansion_tank","unknown_result":"INPUT_REQUIRED"},"exceptions":[],"cross_references":["IR-M14-1391-14.7.8.1-HOT-WATER-EXPANSION-TANK"],"required_inputs":[{"field":"heating.hot_water_heating_systems[].expansion_tank.normal_water_level_above_highest_component_mm","unit":"mm","authority":["GEOMETRY_VERIFIED"]}],"design_actions":["place the open expansion tank so its normal operating water level is at least 1200 mm above the highest heating-system component"],"validator":"open_expansion_tank_elevation","parameters":{"minimum_water_level_above_highest_component_mm":1200},"output_evidence":["highest-system-component elevation","normal tank water-level elevation","signed elevation difference in detail or riser"],"unknown_policy":"INPUT_REQUIRED","llm_override_allowed":false},
