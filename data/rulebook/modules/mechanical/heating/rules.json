    {"rule_id":"IR-M14-1391-14.3.5.1-HEATING-SURFACE-GUARD","version":"1.0.0","owner":"mechanical","subsystem":"heating_equipment_safety","kind":"CONDITIONAL","authority":"STATUTORY_MANDATORY","title_fa":"حفاظت در برابر تماس با سطح گرم بیش از ۹۰ درجه سلسیوس","sources":[{"code":"M14","edition":"1391","clause":"14-3-5-1(p-1)","printed_page":31,"source_ids":["M14-H-001"],"status":"VERIFIED_SOURCE"}],"applicability":{"predicate":"heating_surface_is_inside_space_used_for_occupancy_residence_or_work","unknown_result":"INPUT_REQUIRED"},"exceptions":[{"when":"maximum_accessible_surface_temperature_c <= 90","result":"PASS","reason":"printed threshold does not require the additional direct-contact guard"}],"cross_references":[],"required_inputs":[{"field":"heating.exposed_surfaces[].maximum_accessible_surface_temperature_c","unit":"degC","authority":["PRODUCT_DATA"]},{"field":"heating.exposed_surfaces[].occupied_or_work_space","unit":null,"authority":["GEOMETRY_VERIFIED"]},{"field":"heating.exposed_surfaces[].direct_contact_guard","unit":null,"authority":["GEOMETRY_VERIFIED","PRODUCT_DATA"]}],"design_actions":["for every accessible heating surface in an occupied, residential or work space whose maximum temperature exceeds 90 degC, provide a source-bound guard that prevents direct body contact"],"validator":"heating_surface_guard","parameters":{"guard_trigger_temperature_c":90,"strictly_above_trigger":true},"output_evidence":["surface/product temperature schedule","occupied-space binding","guard geometry and product identity"],"unknown_policy":"INPUT_REQUIRED","llm_override_allowed":false},
